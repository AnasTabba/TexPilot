{
  // Review deployment of the Factory Portal branch (npx wrangler deploy -c wrangler.factory.jsonc).
  // Separate Worker and separate D1 database, so the live Yarnflow site and its ledger are never touched.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "factory-portal",
  "main": "server/cloudflare.mjs",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "factory-portal-db", "database_id": "0e554698-38a8-4c14-9bf1-87f03a766170", "migrations_dir": "drizzle" }
  ],
  "observability": { "enabled": true },
  "triggers": { "crons": ["0 0 * * *"] }
}
