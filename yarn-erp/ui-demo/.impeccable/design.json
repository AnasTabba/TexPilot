  "narrative": {
    "northStar": "The Charcoal-and-Lime Warehouse",
    "overview": "Provisional code-led UI concept, awaiting the user’s desktop and mobile review and approval. This document describes only the isolated `/ui-demo/` prototype; it does not approve a production rollout or replace the production design system.\n\nThe user-selected warehouse dashboard reference resolves the qualitative direction: charcoal olive navigation, a near-white workspace, clean white panels, restrained lime actions, and compact Manrope information. Fabric thumbnails connect quantities and QC states to materials; all stock and inspection results remain illustrative.",
    "keyCharacteristics": [
      "Compact warehouse information with tabular quantities.",
      "Lime selection and actions against charcoal navigation and white panels.",
      "Responsive stock lists and an interactive framed phone preview."
    ],
    "rules": [
      {
        "name": "The Lime Action Rule",
        "body": "Use lime for primary actions and current navigation, as the prototype does. QC states retain their own text labels and semantic fills.",
        "section": "colors"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Keep ordinary work panels flat; reserve pronounced shadows for overlays and the phone presentation frame.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep quantities tabular and units visible.",
      "Do show QC text together with its color; retain the corrected status foregrounds.",
      "Do preserve keyboard focus and reduced-motion support.",
      "Do mark samples and simulated inspection results as illustrative."
    ],
    "donts": [
      "Don’t treat this provisional concept as approval to replace the production UI.",
      "Don’t hide mobile quantity or QC status behind horizontal table scrolling.",
      "Don’t imply that sample scanner results ran a trained model or approved real stock."
    ]
  }
}
