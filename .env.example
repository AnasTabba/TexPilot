TEXPILOT_MODEL_BUNDLE=models/scanner-v2
TEXPILOT_GARMENT_DETECTOR=gdino
TEXPILOT_OCR_BACKEND=apple
TEXPILOT_DEVICE=auto
TEXPILOT_SCAN_STORE=data/scans
TEXPILOT_CORS_ORIGINS=https://yarnflow-factory-glass.thryuil.chatgpt.site,http://localhost:5174,http://127.0.0.1:5174
