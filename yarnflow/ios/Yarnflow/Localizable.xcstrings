          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "حد: 4 اصل تصاویر، ہر ایک 12 MiB، سیٹ 48 MiB اور ہر تصویر 16 میگا پکسل۔"
          }
        }
      }
    },
