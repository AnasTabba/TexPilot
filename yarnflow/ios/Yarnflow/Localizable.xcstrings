    "qc.capture.expired": {
      "comment": "Urdu draft — fluent textile-QC review not yet collected / external gate G8.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draft expired after 24 hours. Capture again."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "مسودہ 24 گھنٹے بعد ختم ہوگیا۔ دوبارہ تصویر لیں۔"
          }
        }
      }
    },
    "qc.capture.guide": {
      "comment": "Urdu draft — fluent textile-QC review not yet collected / external gate G8.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lay the fabric flat and relaxed, use diffuse even light, keep the scale coplanar, and hold the camera steady and square. Take overview, structure and scale views. Do not use digital zoom."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "کپڑا ہموار اور ڈھیلا بچھائیں، یکساں نرم روشنی دیں، پیمانہ اسی سطح پر رکھیں اور کیمرہ ساکن اور سیدھا رکھیں۔ مجموعی، بُنائی اور پیمانے کی تصاویر لیں۔ ڈیجیٹل زوم استعمال نہ کریں۔"
          }
        }
      }
    },
    "qc.capture.heic": {
      "comment": "Urdu draft — fluent textile-QC review not yet collected / external gate G8.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HEIC is unsupported. Choose Settings → Camera → Formats → Most Compatible and recapture. A converted copy is not an original camera capture."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "HEIC قابل قبول نہیں۔ Settings → Camera → Formats → Most Compatible منتخب کر کے دوبارہ تصویر لیں۔ تبدیل شدہ نقل اصل کیمرہ تصویر نہیں۔"
          }
        }
      }
    },
    "qc.capture.tooLarge": {
      "comment": "Urdu draft — fluent textile-QC review not yet collected / external gate G8.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
