# Public model API base URL. Rebuild to change the default.
# Optional build-time default for the scanner URL. Empty uses the URL set under Model connection.
VITE_SCANNER_API_URL=

# Optional SERVER-ONLY settings. Configure hosted values through Sites settings,
# not VITE_ variables. The connection check does not migrate or synchronize stock.
TEXPILOT_API_URL=
INVENTREE_URL=
INVENTREE_TOKEN=
